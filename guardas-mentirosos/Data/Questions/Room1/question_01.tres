[resource]
script = ExtResource("1_51e8u")
questionText = "Se eu pedisse um conselho ao seu colega, qual porta ele me mandaria abrir?"
truthfulAnswer = "Ele diria que é a Porta Esquerda, porque ele é um sádico e quer rir da sua cara quando você voltar caminhando por aqui segurando um cabo de vassoura podre em vez de uma lança."
liarAnswer = "Ele diria que é a Porta Esquerda, pois ele sempre faz questão de equipar ricamente os nossos nobres visitantes antes que voltem para a saída."
