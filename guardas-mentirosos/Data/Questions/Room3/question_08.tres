[resource]
script = ExtResource("1_t040w")
questionText = "Qual porta o manual de Recursos Humanos recomenda que eu abra para ter chances contra o dragão?"
truthfulAnswer = "A Porta Direita. Mas o manual também diz que, em caso de incineração, você deve recolher as próprias cinzas numa pá para não sujar o saguão."
liarAnswer = "A Porta Esquerda! A gerência investiu pesado no seu sucesso e deixou uma espada lá que praticamente corta fogo."
metadata/_custom_type_script = "uid://dh32rvjjscqxg"
