[resource]
script = ExtResource("1_6em58")
questionText = "Se o seu colega me dissesse que você fala a verdade, qual porta você apontaria para o item bom?"
truthfulAnswer = "Eu apontaria a Porta Direita, mas só se você preencher e assinar o 'Termo de Isenção de Responsabilidade por Queimaduras de Dragão' na mesa 4."
liarAnswer = "Eu apontaria a Porta Esquerda, porque meu maior dever cívico é garantir que heróis derrotem répteis gigantes."
