[resource]
script = ExtResource("1_8v5hs")
questionText = "Se eu perguntasse qual porta é a correta, qual delas o seu colega diria que ele mesmo abriria?"
truthfulAnswer = "A Esquerda. Lá tem uma bota furada que ele quer usar como vaso de plantas para enfeitar a guarita."
liarAnswer = "A Direita. Ele adora ostentar armaduras reluzentes e polidas durante o expediente."
